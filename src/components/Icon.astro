---
interface Props {
  name?: string;
  size?: number;
}
const { name = 'flower', size = 20 } = Astro.props;
const decorative = ['flower', 'butterfly'].includes(name);
const goldId = `gold-${crypto.randomUUID()}`;
const paths: Record<string, string> = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  diagonal: 'M5 19 19 5M5 5h14v14',
  back: 'M20 12H4m6-6-6 6 6 6',
  close: 'm6 6 12 12M6 18 18 6',
  share: 'M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7',
  copy: 'M8 8h12v12H8zM4 16V4h12',
  mail: 'M3 5h18v14H3zM3 6l9 7 9-7',
  flower:
    'M12 9C6 0 1 8 8 12c-9 6-1 11 4 4 5 7 13 2 4-4 7-4 2-12-4-3ZM14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
  butterfly:
    'M12 10C8-1 1 3 3 10c1 3 4 3 7 3-8 0-7 9-2 7 2-1 3-4 4-7 1 3 2 6 4 7 5 2 6-7-2-7 3 0 6 0 7-3 2-7-5-11-9 0Zm0 0v7m0-7L9 6m3 4 3-4',
  leaf: 'M4 20C4 6 14 3 21 3c0 10-3 16-12 14M4 20l12-12',
  expand: 'M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6',
  up: 'M12 20V4m-6 6 6-6 6 6',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  data-motif={decorative ? name : undefined}
>
  {decorative && (
    <defs>
      <linearGradient id={goldId} x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
        <stop stop-color="var(--gold-shadow)" />
        <stop offset=".3" stop-color="var(--gold)" />
        <stop offset=".46" stop-color="var(--gold-highlight)" />
        <stop offset=".6" stop-color="var(--gold)" />
        <stop offset="1" stop-color="var(--gold-shadow)" />
      </linearGradient>
    </defs>
  )}
  <path d={paths[name] || paths.flower} stroke={decorative ? `url(#${goldId})` : undefined} />
</svg>
