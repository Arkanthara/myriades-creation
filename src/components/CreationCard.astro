---
import type { Creation } from '../lib/creations';
import { creationUrl } from '../lib/creations';
import { site } from '../lib/config';
import Icon from './Icon.astro';
interface Props {
  entry: Creation;
  compact?: boolean;
  gallery?: string;
  heading?: 'h2' | 'h3';
}
const { entry, compact = false, gallery, heading: Heading = 'h3' } = Astro.props;
const image = entry.data.images[0];
---

<article class:list={['creation-card', { compact }]} data-category={entry.data.category}>
  <div class="card-image-wrap">
    <a href={creationUrl(entry)} class="card-image" tabindex="-1" aria-hidden="true">
      <img
        src={image.src}
        alt=""
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        style={{ objectPosition: image.position }}
      />
    </a>
    {entry.data.demo && <span class="demo-badge">{site.ui.demoBadge}</span>}
    {gallery && (
      <button
        class="enlarge-button"
        aria-label={`${site.ui.enlarge} : ${entry.data.title}`}
        data-gallery-open
        data-gallery-group={gallery}
        data-src={image.src}
        data-alt={image.alt}
        data-caption={image.caption || entry.data.title}
      >
        <Icon name="expand" size={18} />
      </button>
    )}
  </div>
  <div class="card-meta">
    <span>{entry.data.category}</span>
    <span>{entry.data.technique}</span>
  </div>
  <a class="card-title" href={creationUrl(entry)}>
    <Heading>{entry.data.title}</Heading>
    <Icon name="diagonal" size={19} />
  </a>
  {!compact && <p class="card-description">{entry.data.description}</p>}
</article>
