---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const goldId = `ornament-gold-${crypto.randomUUID()}`;
---

<svg
  class:list={['ornament', className]}
  viewBox="0 0 240 56"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={goldId} x1="0" y1="0" x2="0.8" y2="1">
      <stop stop-color="var(--gold-shadow)" />
      <stop offset=".3" stop-color="var(--gold)" />
      <stop offset=".48" stop-color="var(--gold-highlight)" />
      <stop offset=".65" stop-color="var(--gold)" />
      <stop offset="1" stop-color="var(--gold-shadow)" />
    </linearGradient>
  </defs>
  <g stroke={`url(#${goldId})`} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M13 35h52c15 0 19-12 9-12-9 0-8 18 10 18h17m126-6h-52c-15 0-19-12-9-12 9 0 8 18-10 18h-17" />
    <path d="M120 28c-10-29-31-22-25-5 3 8 11 10 21 9-23 1-18 23-7 16 6-4 9-11 11-16 2 5 5 12 11 16 11 7 16-15-7-16 10 1 18-1 21-9 6-17-15-24-25 5Zm0 0v13m0-13-6-10m6 10 6-10" />
    <path d="M36 32c-6-9-11-1-4 3-9 6-1 11 4 4 5 7 13 2 4-4 7-4 2-12-4-3Zm168 0c-6-9-11-1-4 3-9 6-1 11 4 4 5 7 13 2 4-4 7-4 2-12-4-3Z" />
  </g>
</svg>
