{
  "name": "myriade-creation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "check": "astro check && tsx scripts/validate-content.ts",
    "build": "astro build && tsx scripts/check-build.ts",
    "preview": "astro preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run build && npm run test:e2e && npm run test:order",
    "content:new": "tsx scripts/new-creation.ts",
    "validate:production": "tsx scripts/validate-content.ts --production",
    "deploy": "npm run validate:production && npm run build && wrangler pages deploy dist",
    "test:order": "tsx scripts/test-custom-order.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "astro": "^7.4.11",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "parse5": "^8.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
